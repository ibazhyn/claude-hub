      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git stash pop*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git commit -a*)",
      "Bash(git commit --no-verify*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -d*)",
      "PowerShell(git clean -x*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .*)",
      "PowerShell(git stash pop*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git rebase*)",
      "PowerShell(git commit --amend*)",
      "PowerShell(git commit -a*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git update-ref -d*)",
      "PowerShell(git reflog expire*)",
      "PowerShell(git gc --prune*)"
