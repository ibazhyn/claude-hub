      "Bash(git -C * rev-list *)",
      "Bash(git -C * merge-base *)",
      "Bash(git -C * ls-files)",
      "Bash(git -C * ls-files *)",
      "Bash(git -C * symbolic-ref *)",
      "Bash(git -C * remote get-url *)",
      "Bash(git -C * remote -v)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * worktree list)",
      "Bash(git -C * worktree list *)",
      "Bash(git -C * stash list)",
      "Bash(git -C * stash list *)",
      "Bash(git -C * config --get *)",
      "Bash(git -C * config user.email)",
      "Bash(git -C * config user.name)",
      "Bash(git --version)",
      "Bash(date -Iseconds)",
      "Bash(python tools/hub.py*)",
      "Bash(python3 tools/hub.py*)",
      "Bash(py -3 tools/hub.py*)",
      "Bash(python tools/guard_test.py*)",
