{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "hub-orchestrator",
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Agent(hub-session-worker)",
      "Agent(hub-qa-reviewer)",
      "Agent(hub-context-analyst)",
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "ToolSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git symbolic-ref*)",
      "Bash(git remote get-url*)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git stash list*)",
      "Bash(git config --get*)",
      "Bash(git config user.email)",
      "Bash(git config user.name)",
      "Bash(git config --global user.email)",
      "Bash(git config --global user.name)",
      "Bash(git -C * status)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log)",
      "Bash(git -C * log *)",
      "Bash(git -C * show)",
      "Bash(git -C * show *)",
